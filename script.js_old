const gridHeight = imageGrid.length;
const gridWidth = imageGrid[0].length;

const canvas = document.getElementById('lainCanvas');
const ctx = canvas.getContext('2d');
const textPattern = "LAIN ";
let offsetX = 0;

function resizeCanvas() {
    const scale = Math.min(window.innerWidth / gridWidth, window.innerHeight / gridHeight) * 1.10;
    const fontSize = Math.floor(scale);
    
    canvas.width = gridWidth * fontSize;
    canvas.height = gridHeight * fontSize;
    
    ctx.font = `bold ${fontSize}px monospace`;
    ctx.textBaseline = 'top';
    ctx.textAlign = 'left';
    return fontSize;
}

let fontSize = resizeCanvas();

window.addEventListener('resize', () => {
    fontSize = resizeCanvas();
});

function draw() {
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    for (let y = 0; y < gridHeight; y++) {
        for (let x = 0; x < gridWidth; x++) {
            const color = imageGrid[y][x];
            ctx.fillStyle = `rgb(${color[0]}, ${color[1]}, ${color[2]})`;
            
            const charIndex = Math.floor((x + Math.floor(offsetX)) % textPattern.length + textPattern.length) % textPattern.length;
            const char = textPattern[charIndex];

            const px = x * fontSize;
            const py = y * fontSize;

            ctx.fillText(char, px, py);
        }
    }

    
    offsetX += 0.25;
    requestAnimationFrame(draw);
}

draw();
